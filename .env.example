# Server
PORT=3000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/favour-store
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/favour-store
MONGODB_URI=mongodb://127.0.0.1:27017/favour-store

# Seed the six default products the first time the database is empty.
SEED_DEFAULT_PRODUCTS=true
